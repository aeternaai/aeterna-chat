          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Arrow MCP Manager to Servers -->
        <mxCell id="edge_mcp_servers" value="Execute" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcp_manager" target="mcp_servers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="llm_engine_mcp" value="&lt;b&gt;LLM Inference Engine&lt;/b&gt;&lt;br&gt;(With Tool Results)&lt;br&gt;&lt;br&gt;Prompt = Query + Tool Output&lt;br&gt;Generate Final Response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="200" y="710" width="220" height="100" as="geometry"/>
        </mxCell>
        
        <!-- Arrow MCP to LLM -->
