        <mxCell id="llm_engine_rag" value="&lt;b&gt;LLM Inference Engine&lt;/b&gt;&lt;br&gt;(With Context)&lt;br&gt;&lt;br&gt;Prompt = Query + Context&lt;br&gt;+ Source Citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
