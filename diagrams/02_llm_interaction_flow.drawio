          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Combined Path: RAG + MCP -->
        <mxCell id="path4_title" value="Path 4: Combined (RAG + MCP Tools)" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;fontColor=#333333;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="640" width="280" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="orchestrator_combined" value="&lt;b&gt;Multi-Source Orchestrator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Combines:&lt;br&gt;1. RAG context from knowledge base&lt;br&gt;2. MCP tool results&lt;br&gt;3. Generates comprehensive response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
