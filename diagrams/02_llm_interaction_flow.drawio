        <!-- Notes -->
        <mxCell id="notes_box" value="&lt;b&gt;Key Features:&lt;/b&gt;&lt;br&gt;• Intelligent routing based on query analysis&lt;br&gt;• Multiple data sources can be combined&lt;br&gt;• RAG respects workspace permissions&lt;br&gt;• MCP tools provide real-time external data&lt;br&gt;• All responses include source attribution&lt;br&gt;• Streaming responses for better UX" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
