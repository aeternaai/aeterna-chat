        <!-- Decision Examples Box -->
        <mxCell id="examples_box" value="&lt;b&gt;Routing Decision Examples:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &quot;What is 2+2?&quot; → Path 1 (Simple)&lt;br&gt;&lt;br&gt;• &quot;Summarize our Q4 marketing strategy&quot; → Path 2 (RAG)&lt;br&gt;  Searches workspace docs&lt;br&gt;&lt;br&gt;• &quot;Create a Jira ticket for bug fix&quot; → Path 3 (MCP)&lt;br&gt;  Uses Jira MCP server&lt;br&gt;&lt;br&gt;• &quot;Draft email to client about project status&quot; → Path 4 (RAG+MCP)&lt;br&gt;  Retrieves project docs + uses email MCP&lt;br&gt;&lt;br&gt;• &quot;What did John ask in today's email about feature X?&quot; → Path 4&lt;br&gt;  Uses email MCP + searches Confluence for feature X docs" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
