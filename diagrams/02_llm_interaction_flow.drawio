        <!-- Arrow RAG to LLM -->
        <mxCell id="edge_rag_llm" value="Retrieved Context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rag_retriever" target="llm_engine_rag">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Path 3: MCP Tool Usage -->
        <mxCell id="path3_title" value="Path 3: MCP Tool Usage (External Actions)" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="330" width="300" height="30" as="geometry"/>
