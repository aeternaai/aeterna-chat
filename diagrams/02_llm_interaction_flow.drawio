        </mxCell>
        
        <!-- Arrows showing combined path -->
        <mxCell id="edge_rag_combined" value="Context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="llm_engine_rag" target="orchestrator_combined">
