        <mxCell id="mcp_manager" value="&lt;b&gt;MCP Server Manager&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Identify Required Tools&lt;br&gt;- Route to MCP Server&lt;br&gt;- Execute Tool Call&lt;br&gt;- Handle Timeouts/Errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="200" y="380" width="220" height="120" as="geometry"/>
        </mxCell>
        
        <mxCell id="mcp_servers" value="&lt;b&gt;MCP Servers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Examples:&lt;br&gt;• Jira (tickets)&lt;br&gt;• Confluence (docs)&lt;br&gt;• Email (send/read)&lt;br&gt;• Calendar (schedule)&lt;br&gt;• File operations&lt;br&gt;• Web fetch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="200" y="530" width="220" height="140" as="geometry"/>
        </mxCell>
        
        <!-- Arrow router to MCP -->
