        <mxCell id="response_formatter" value="&lt;b&gt;Response Formatter&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Format final response&lt;br&gt;- Add source citations&lt;br&gt;- Add tool usage logs&lt;br&gt;- Stream to UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
