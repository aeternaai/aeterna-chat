                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="delivery_title" value="Delivery Layer" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;fontColor=#333333;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="900" y="860" width="220" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="delivery_manager" value="&lt;b&gt;Delivery Manager&lt;/b&gt;&lt;br&gt;&lt;br&gt;• OS Notifications&lt;br&gt;• In-app Notifications&lt;br&gt;• Notification Center&lt;br&gt;• Priority Routing&lt;br&gt;• Do Not Disturb Rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="900" y="910" width="220" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="edge_generator_delivery" value="Formatted Notification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" parent="1" source="notification_generator" target="delivery_manager" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="user_notification" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;&lt;br&gt;Receives:&lt;br&gt;• Desktop notification&lt;br&gt;• In-app alert&lt;br&gt;• Can act immediately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="910" width="180" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="edge_delivery_user" value="Display" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" parent="1" source="delivery_manager" target="user_notification" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="example_title" value="Example: Email About Feature X" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="920" y="100" width="430" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="example_box" value="&lt;b&gt;Step-by-Step Flow:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Event:&lt;/b&gt; Email arrives from client asking about &quot;Feature X&quot;&lt;br&gt;&lt;br&gt;2. &lt;b&gt;Monitor:&lt;/b&gt; Event Monitor detects new email via webhook&lt;br&gt;&lt;br&gt;3. &lt;b&gt;Analyze:&lt;/b&gt; Relevance Analyzer (LLM) determines:&lt;br&gt;   • Sender is important client&lt;br&gt;   • User is working on Feature X (from User Context)&lt;br&gt;   • Question requires response → HIGH PRIORITY&lt;br&gt;&lt;br&gt;4. &lt;b&gt;Gather Context:&lt;/b&gt; Context Gatherer:&lt;br&gt;   • Extracts topic: &quot;Feature X&quot;&lt;br&gt;   • Queries Vector DB for Feature X docs&lt;br&gt;   • Retrieves Confluence pages about Feature X&lt;br&gt;   • Queries Jira for related tickets&lt;br&gt;&lt;br&gt;5. &lt;b&gt;Generate:&lt;/b&gt; Notification Generator creates:&lt;br&gt;   &lt;i&gt;&quot;📧 Email from [Client] about Feature X&lt;br&gt;   &lt;br&gt;   Summary: Client asks about deployment timeline&lt;br&gt;   &lt;br&gt;   Relevant docs found:&lt;br&gt;   • Feature X Spec (Confluence)&lt;br&gt;   • TICKET-123: Feature X Deploy (Jira)&lt;br&gt;   &lt;br&gt;   Suggested response:&lt;br&gt;   &#39;Feature X is scheduled for Q1 deploy per TICKET-123....&#39;&lt;br&gt;   &lt;br&gt;   [View Details] [Draft Reply] [Dismiss]&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;6. &lt;b&gt;Deliver:&lt;/b&gt; OS notification + in-app alert&lt;br&gt;&lt;br&gt;7. &lt;b&gt;User Action:&lt;/b&gt; Clicks &quot;Draft Reply&quot; → opens email client&lt;br&gt;   with pre-populated response using gathered context" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=10;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="920" y="150" width="430" height="480" as="geometry"/>
                </mxCell>
                <mxCell id="features_box" value="&lt;b&gt;Key Features:&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ Truly proactive (not reactive)&lt;br&gt;✓ Context-aware intelligence&lt;br&gt;✓ Multi-source information synthesis&lt;br&gt;✓ Actionable suggestions&lt;br&gt;✓ Respects user preferences&lt;br&gt;✓ Privacy-first (all local)&lt;br&gt;✓ Reduces cognitive load&lt;br&gt;✓ Saves time on context switching" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=10;spacingTop=5;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="920" y="660" width="240" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="tech_box" value="&lt;b&gt;Technical Considerations:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Rate limiting on external APIs&lt;br&gt;• Exponential backoff for retries&lt;br&gt;• Event deduplication&lt;br&gt;• User preference learning&lt;br&gt;• Battery/resource optimization&lt;br&gt;• Privacy: no data leaves device&lt;br&gt;• Configurable monitoring intervals&lt;br&gt;• Notification fatigue prevention" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=10;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="660" width="240" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="filter_system" value="&lt;b&gt;Filter &amp; Learning System&lt;/b&gt;&lt;br&gt;&lt;br&gt;• User dismisses notification → Learn&lt;br&gt;• Track which notifications are acted on&lt;br&gt;• Adjust relevance scoring over time&lt;br&gt;• Explicit ignore rules&lt;br&gt;• Time-of-day preferences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="50" y="630" width="260" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="edge_filter_analyzer" value="Feedback Loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;dashed=1;dashPattern=8 8;strokeColor=#666666;" parent="1" source="filter_system" target="relevance_analyzer" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge_user_filter" value="User Feedback&lt;br&gt;(dismiss/act)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=8 8;strokeColor=#666666;" parent="1" source="user_notification" target="filter_system" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1170" y="1040"/>
                            <mxPoint x="350" y="1040"/>
