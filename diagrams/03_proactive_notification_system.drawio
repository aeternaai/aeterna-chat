                <mxCell id="generation_title" value="Notification Generation Layer" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="380" y="810" width="260" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="notification_generator" value="&lt;b&gt;Notification Generator&lt;/b&gt;&lt;br&gt;(LLM-powered)&lt;br&gt;&lt;br&gt;Creates:&lt;br&gt;• Summary of event&lt;br&gt;• Why it&#39;s relevant&lt;br&gt;• Context from sources&lt;br&gt;• Suggested actions/responses&lt;br&gt;• Source citations&lt;br&gt;• Priority level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="380" y="860" width="260" height="160" as="geometry"/>
